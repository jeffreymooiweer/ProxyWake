# ProxyWake environment variables (Docker Compose)
#
# Copy this file to .env and edit the values:
#   cp .env.example .env

# Password for the web interface. Strongly recommended.
# Leave empty to set it in the first-run setup wizard instead.
PROXYWAKE_PASSWORD=ChangeMeNow

# Timezone used for scheduled wakes, e.g. Europe/Amsterdam or America/New_York.
TZ=UTC

# Optional: fixed API key for the reverse-proxy integration.
# Leave empty to let ProxyWake generate one (shown under Settings).
# PROXYWAKE_API_KEY=

# Optional: fixed secret for sessions and credential encryption.
# ProxyWake generates and stores one automatically; set this only if you
# want to control it yourself (e.g. for restoring on another machine).
# PROXYWAKE_SECRET_KEY=

# Optional: comma-separated browser origins allowed to call the API
# (only needed when the UI is served from a different hostname).
# PROXYWAKE_ALLOWED_ORIGINS=

# Set to true when the web UI is only ever opened over HTTPS.
# PROXYWAKE_SESSION_COOKIE_SECURE=true

# Host port for the web UI. Only used when "ports:" is enabled in
# docker-compose.yml (bridge networking). With host networking the UI is
# always on port 5001.
PROXYWAKE_PORT=8462

# Optional: pin a specific image version (default: latest).
# PROXYWAKE_IMAGE=jeffersonmouze/proxywake:4.4.0
