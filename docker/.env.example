# Local development build - copy to .env and edit:
#   cp .env.example .env

# Password for the web interface (recommended)
PROXYWAKE_PASSWORD=StrongPassword123

# Timezone for scheduled wakes
TZ=UTC

# Optional: fixed API key for the reverse-proxy integration
# PROXYWAKE_API_KEY=

# Optional: fixed session / credential encryption secret
# PROXYWAKE_SECRET_KEY=

# Host port for the web UI (default 8462)
PROXYWAKE_PORT=8462
